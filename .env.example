# ─── Aplicação ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Banco de dados (SQL Server) ─────────────────────────────────────────────
# Formato Prisma SQL Server:
# sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=api_auth;user=sa;password=YourStrong@Passw0rd;trustServerCertificate=true"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# ─── Segurança ───────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30

# ─── Rate Limiting (global) ──────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=5

# ─── CORS ────────────────────────────────────────────────────────────────────
# Múltiplas origens separadas por vírgula. Nunca use * em produção.
CORS_ORIGIN=http://localhost:3000,http://localhost:4200

# ─── Resiliência (cockatiel) ─────────────────────────────────────────────────
DB_OPERATION_TIMEOUT_MS=10000
DB_RETRY_MAX_ATTEMPTS=3
DB_CIRCUIT_BREAKER_THRESHOLD=5
DB_CIRCUIT_BREAKER_HALF_OPEN_AFTER_MS=30000

# ─── E-mail (opcional — sem SMTP, tokens são logados no console) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
